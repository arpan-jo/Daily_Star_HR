# Copy to .env and fill in. Read by react-native-dotenv (JS, via '@env') and by
# android/app/build.gradle (Kotlin, via BuildConfig).
mainURLL=
arlURLL=
rscURLL=
crmURLL=
erpPeopleDeskURLL=
erpiBOSURLL=
openMapp=
commonURLL=
secretKeyy=
secureStorageKeyy=

googleWebClientIdd=
linkedInClientIdd=
linkedInClientSecrett=

# MQTT broker for realtime GPS tracking.
mqttServerUri=
mqttUsername=
mqttPassword=

# Android build only (not exposed to JS).
MAPS_API_KEY=
# Firebase Android API key. Injected into android/app/google-services.json at build
# time from google-services.json.template.
FIREBASE_API_KEY=

# DeepSeek key for on-device micro-app generation. NOTE: .env is tracked in
# git and this key ships inside the app bundle — see src/modules/micro-apps/.
deepseekKeyy=
# Optional: set either to offer that model in the generator's picker.
openaiKeyy=
claudeKeyy=
